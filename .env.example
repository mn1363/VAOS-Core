# VAOS environment overrides.
#
# These are the only environment variables `src/core/config.py` currently
# recognizes (see `_ENV_OVERRIDES` in that file). Each one, when set,
# overrides the matching value loaded from `configs/config.yaml`. Copy this
# file to `.env` and adjust as needed; VAOS_* variables are read directly
# from the process environment -- `core` does not load `.env` files itself.
#
# Values here are examples, not defaults; see configs/config.yaml for the
# actual shipped defaults.

VAOS_APP_NAME=vaos
VAOS_APP_VERSION=0.1.0
VAOS_ENVIRONMENT=development
VAOS_DEBUG=false
