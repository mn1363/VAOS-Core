# VAOS environment configuration reference.
# Copy this file to `.env` (repo root) and adjust values as needed.
# All variables are optional; unset variables fall back to the defaults
# defined on the corresponding dataclass in core/config/settings.py.

VAOS_ENVIRONMENT=development
VAOS_DEBUG=false

VAOS_DATABASE_DSN=sqlite+aiosqlite:///./vaos.db
VAOS_DATABASE_POOL_SIZE=5

VAOS_VECTOR_PROVIDER=none
VAOS_VECTOR_DIMENSIONS=768
VAOS_VECTOR_ENDPOINT=

VAOS_GRAPH_PROVIDER=none
VAOS_GRAPH_ENDPOINT=

VAOS_MEMORY_PROVIDER=none
VAOS_MEMORY_TTL_SECONDS=3600

VAOS_API_HOST=0.0.0.0
VAOS_API_PORT=8000
VAOS_API_TITLE=VAOS API

VAOS_LOG_LEVEL=INFO
VAOS_LOG_JSON=false
